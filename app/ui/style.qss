/* Tomato — paper & ink. Warm stock, hairline rules, one vermilion accent.
   Fonts: Segoe UI for interface, SimSun for display, Consolas for figures. */

QWidget {
    font-family: "Segoe UI", "Microsoft YaHei UI", "PingFang SC", sans-serif;
    font-size: 13px;
    color: @text;
    background-color: transparent;
    selection-background-color: @selection;
    selection-color: @selection_text;
}

QMainWindow, QWidget#centralWidget, QWidget#loginPage { background: transparent; }
QDialog, QMessageBox, QColorDialog { background-color: @surface; }

QToolTip {
    background-color: @surface; color: @text;
    border: 1px solid @border_strong; border-radius: 2px; padding: 7px 10px;
}

/* ---------- typescale ---------- */
QLabel { border: none; background: transparent; }
QLabel[class="pageTitle"] {
    font-family: "Songti SC", "SimSun", serif;
    font-size: 38px; font-weight: 700; color: @title; letter-spacing: 4px;
}
QLabel[class="sectionTitle"] { font-size: 14px; font-weight: 600; color: @text; letter-spacing: 1px; }
QLabel[class="mutedLabel"], QLabel#subtitleLabel { color: @muted; font-size: 13px; }
QLabel[class="emptyState"] { color: @muted; font-size: 13px; padding: 18px 4px; }
QLabel[class="fieldLabel"] { color: @muted; font-size: 12px; letter-spacing: 1px; }
QLabel[class="settingsTitle"] {
    font-family: "Songti SC", "SimSun", serif;
    font-size: 21px; font-weight: 700; color: @title; letter-spacing: 2px;
}
QLabel#msgLabel, QLabel#settingsSaveStatus { color: @danger; min-height: 18px; font-size: 11px; }
QLabel#settingsSaveStatus[feedback="success"], QLabel#msgLabel[feedback="success"] { color: @success; }
QLabel#settingsSaveStatus[feedback="error"], QLabel#msgLabel[feedback="error"] { color: @danger; }
QLabel#dateBadge {
    color: @muted; font-size: 11px; letter-spacing: 1px;
    border: 1px solid @border; border-radius: 2px; padding: 6px 10px;
}

QLabel[class="monoCaption"] {
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 11px; letter-spacing: 1.6px; color: @muted;
}
QLabel[class="weekValue"] {
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 12px; color: @blue;
}

/* ---------- top bar ---------- */
QFrame#navBar { background: transparent; border: none; }
QLabel#brandName { font-size: 12px; font-weight: 600; letter-spacing: 6px; color: @title; }
QLabel#brandSub { font-size: 10px; letter-spacing: 2.4px; color: @muted; }
QLabel#localStatus { color: @muted; font-size: 11px; letter-spacing: 1px; }
QFrame#sidebarRule { background: @rule_soft; border: none; }
QLabel#avatar {
    border: 1px solid @border_strong; border-radius: 2px;
    color: @muted; font-size: 11px; font-weight: 600;
}
QLabel#accountLabel { color: @muted; font-size: 12px; }
QPushButton.navBtn {
    background: transparent; color: @muted; text-align: left;
    border: none; border-bottom: 1.5px solid transparent;
    padding: 6px 2px 5px 2px; letter-spacing: 2px; font-size: 13px;
    min-height: 18px;
}
QPushButton.navBtn:hover { color: @text; }
QPushButton.navBtn:checked { color: @text; border-bottom: 1.5px solid @accent; }

/* ---------- controls ---------- */
QPushButton {
    background: transparent; color: @text;
    border: 1px solid @border_strong; border-radius: 2px;
    padding: 8px 16px; min-height: 17px; font-size: 13px; letter-spacing: 1px;
}
QPushButton:hover { background: @hover; color: @title; }
QPushButton:pressed { background: @pressed; }
QPushButton:focus { border-color: @focus; }
QPushButton:disabled { color: @disabled; border-color: @border; background: transparent; }

QPushButton#primaryButton, QPushButton#btnPause {
    background: @ink_fill; color: @on_ink; border: 1px solid @ink_fill;
    font-weight: 600; padding: 9px 20px;
}
QPushButton#primaryButton:hover, QPushButton#btnPause:hover {
    background: @accent; border-color: @accent;
}
QPushButton#primaryButton:pressed, QPushButton#btnPause:pressed { background: @accent_hover; border-color: @accent_hover; }
QPushButton#primaryButton:disabled, QPushButton#btnPause:disabled {
    background: transparent; color: @disabled; border-color: @border;
}
QPushButton#ghostButton { border-color: transparent; color: @muted; padding: 6px 8px; }
QPushButton#ghostButton:hover { color: @text; background: transparent; }
QPushButton#textButton {
    border: none; color: @muted; padding: 2px 0; font-size: 12px; letter-spacing: 1px; min-height: 18px;
}
QPushButton#textButton:hover { color: @accent; background: transparent; }
QPushButton#btnStop {
    border-color: @border_strong; color: @muted; padding-left: 18px; padding-right: 18px;
}
QPushButton#btnStop:hover { color: @danger; border-color: @danger_border; background: @danger_bg; }
QPushButton#btnStop:disabled { color: @disabled; border-color: @border; background: transparent; }
QPushButton#toggleButton { color: @muted; border-color: @border; border-radius: 2px; }
QPushButton#toggleButton:checked { color: @accent_text; border-color: @accent_border; background: @accent_soft; }
QPushButton#navArrowButton {
    padding: 0; min-width: 30px; max-width: 30px; min-height: 30px; max-height: 30px;
    border: 1px solid @border; border-radius: 2px; color: @muted;
}
QPushButton#navArrowButton:hover { color: @text; border-color: @border_strong; }
QPushButton.colorBtn { padding: 0; min-width: 0; min-height: 0; border-radius: 16px; }
QPushButton#hotkeyRecorder {
    font-family: "Consolas", "Cascadia Mono", monospace;
    background: @surface; color: @text; border: 1px solid @border_strong; border-radius: 2px;
    letter-spacing: 1px;
}
QPushButton#hotkeyRecorder:hover { background: @hover; }
QPushButton#hotkeyRecorder[recording="true"] {
    background: @accent_soft; color: @accent_text; border-color: @accent;
}

QLineEdit, QSpinBox, QDateTimeEdit, QTextEdit, QComboBox, QDateEdit {
    background: @input; color: @text;
    border: 1px solid @border; border-radius: 2px;
    padding: 8px 10px;
    selection-background-color: @selection; selection-color: @selection_text;
}
QLineEdit { min-height: 18px; }
QLineEdit, QTextEdit { placeholder-text-color: @placeholder; }
QLineEdit:focus, QSpinBox:focus, QDateTimeEdit:focus, QTextEdit:focus, QComboBox:focus, QDateEdit:focus {
    border-color: @focus;
}
QLineEdit:disabled, QSpinBox:disabled, QTextEdit:disabled { color: @disabled; border-color: @border; }
QSpinBox::up-button, QSpinBox::down-button { width: 20px; border: none; background: transparent; }
QDateTimeEdit::drop-down, QDateEdit::drop-down { width: 22px; border: none; background: transparent; }
QComboBox::drop-down { width: 24px; border: none; background: transparent; }
QComboBox::down-arrow { image: none; }
QComboBox QAbstractItemView {
    background: @surface; color: @text; border: 1px solid @border_strong;
    selection-background-color: @accent_soft; selection-color: @accent_text;
    outline: none;
}

QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; border: none; }
QScrollArea#modeScroll { background: transparent; }
QScrollBar:vertical { background: transparent; width: 9px; margin: 2px; }
QScrollBar::handle:vertical { background: @track; border-radius: 0; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: @border_strong; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 2px; }
QScrollBar::handle:horizontal { background: @track; min-width: 28px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- focus workspace ---------- */
QFrame#timerCard { background: transparent; border: none; border-radius: 0; }
QLabel#stateChip {
    color: @muted; font-size: 11px; letter-spacing: 2px;
    border: none; padding: 2px 0;
}
QLabel#stateChip[active="true"] { color: @accent; }
QLabel#modeLabel {
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 12px; letter-spacing: 3px; color: @muted;
}
QLabel#timerLabel {
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 86px; font-weight: 400; letter-spacing: -1px;
    color: @title; padding: 0;
}
QLabel#statusLabel { color: @muted; font-size: 12px; letter-spacing: 1px; }
QLabel#reminderHintLabel { color: @muted; font-size: 11px; letter-spacing: 1px; }
QLabel#todayTotal {
    font-family: "Songti SC", "SimSun", serif;
    font-size: 46px; font-weight: 700; color: @title;
}
QLabel#todayUnit { color: @muted; font-size: 12px; letter-spacing: 2px; }

/* mode pills in the dock */
QPushButton.modeBtn {
    background: transparent; color: @muted;
    border: none; border-radius: 99px;
    padding: 8px 16px; font-size: 12.5px; letter-spacing: 1px; min-height: 16px;
}
QPushButton.modeBtn:hover { color: @text; background: @hover; }
QPushButton.modeBtn:checked {
    color: @pill_text; font-weight: 600;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 @pill_from, stop:0.55 @pill_from, stop:0.55 @pill_to, stop:1 @pill_to);
}
QPushButton.modeBtn:focus { border: 1px solid @accent_border; }
QPushButton#dockAdd {
    border: none; color: @muted; padding: 6px 10px; font-size: 15px; border-radius: 99px;
}
QPushButton#dockAdd:hover { color: @accent; background: transparent; }

/* ---------- settings ---------- */
QTabWidget::pane { border: none; }
QTabBar::tab {
    color: @muted; background: transparent; border: none;
    border-bottom: 1.5px solid transparent; padding: 8px 2px; margin-right: 24px;
    font-size: 13px; letter-spacing: 2px;
}
QTabBar::tab:selected { color: @text; border-bottom: 1.5px solid @accent; }
QTabBar::tab:hover:!selected { color: @text; }
QTabBar::tab:focus { background: transparent; }

QFrame#settingsCard, QFrame#passwordPanel {
    background: transparent; border: none; border-top: 1px solid @rule_soft;
    border-radius: 0;
}
QFrame#settingsCard QLabel[class="sectionTitle"] { font-size: 13px; letter-spacing: 1px; }

/* ---------- history ---------- */
QLabel#dateLabel {
    font-family: "Songti SC", "SimSun", serif;
    color: @title; font-size: 20px; font-weight: 700; letter-spacing: 2px;
}
QLabel#summaryTotalLabel {
    font-family: "Songti SC", "SimSun", serif;
    color: @title; font-size: 34px; font-weight: 700; padding: 10px 0; letter-spacing: 1px;
}
QFrame#periodCard, QFrame#taskStatsSummary {
    background: transparent; border: none; border-top: 1px solid @rule; border-radius: 0;
}
QLabel#periodTotalLabel {
    font-family: "Songti SC", "SimSun", serif;
    color: @title; font-size: 26px; font-weight: 700; padding: 6px 0;
}
QLabel[class="periodTitle"] { color: @text; font-size: 13px; font-weight: 600; letter-spacing: 2px; }
QLabel[class="periodRange"] { color: @muted; font-size: 11px; letter-spacing: 1px; }
QLabel[class="periodModeName"] { color: @text; font-size: 12px; }
QLabel#taskMetricValue {
    font-family: "Songti SC", "SimSun", serif;
    color: @title; font-size: 22px; font-weight: 700; padding: 3px 0;
}
QLabel#taskStatsStatus { color: @muted; font-size: 11px; }
QProgressBar#taskPeriodBar { background: @track; border: none; border-radius: 0; }
QProgressBar#taskPeriodBar::chunk { background: @accent; }

QTableWidget, QTableView {
    background: transparent; alternate-background-color: transparent;
    border: none; border-top: 1px solid @rule;
    gridline-color: transparent;
    selection-background-color: @accent_soft; selection-color: @text;
    outline: none;
}
QTableWidget::item, QTableView::item { padding: 9px 10px; border: none; border-bottom: 1px solid @rule_soft; }
QTableWidget::item:selected, QTableView::item:selected { background: @accent_soft; color: @text; }
QHeaderView { background: transparent; }
QHeaderView::section {
    background: transparent; color: @muted;
    padding: 8px 10px; border: none; border-bottom: 1px solid @rule;
    font-size: 11px; font-weight: 500; letter-spacing: 1.6px;
}
QTableCornerButton::section { background: transparent; border: none; }

QFrame#historyManageHeader { background: transparent; border: none; }
QLabel#historyManageTitle {
    font-family: "Songti SC", "SimSun", serif;
    font-size: 21px; font-weight: 700; letter-spacing: 2px;
}
QLabel#historyManageHint { color: @muted; font-size: 12px; }
QFrame#historyManageSummaryCard {
    background: transparent; border: none; border-top: 1px solid @rule; border-radius: 0;
}
QLabel#historyManageSummaryTitle, QLabel#historyManageModesTitle {
    font-size: 11px; font-weight: 600; letter-spacing: 1.6px; color: @muted;
}
QLabel#historyManageTotalLabel {
    font-family: "Songti SC", "SimSun", serif;
    color: @title; font-size: 34px; font-weight: 700;
}
QWidget[class="historyManageModeRow"] { background: transparent; border-top: 1px solid @rule_soft; }
QLabel[class="historyManageModeName"], QLabel[class="historyManageModeDuration"] { font-size: 12px; }
QLabel#historyManageEmpty { color: @muted; padding: 20px 4px; }
QPushButton#deleteRecordsButton { color: @danger; border-color: @danger_border; }
QPushButton#deleteRecordsButton:hover { background: @danger_bg; border-color: @danger_border; }
QPushButton#deleteRecordsButton:disabled { color: @disabled; border-color: @border; background: transparent; }

/* ---------- calendar & menus ---------- */
QCalendarWidget { background: @surface; color: @text; }
QCalendarWidget QWidget#qt_calendar_navigationbar { background: @surface_alt; }
QCalendarWidget QToolButton { color: @text; background: transparent; padding: 6px; border: none; }
QCalendarWidget QSpinBox { padding: 0; min-width: 60px; border: none; }
QCalendarWidget QAbstractItemView {
    background: @surface; selection-background-color: @accent; selection-color: @on_accent; outline: none;
}
QCalendarWidget QAbstractItemView::item { padding: 0; margin: 0; border: none; }
QCalendarWidget QAbstractItemView:disabled { color: @disabled; }
QMenu { background: @surface; border: 1px solid @border_strong; padding: 4px; }
QMenu::item { padding: 7px 20px; border-radius: 0; }
QMenu::item:selected { background: @accent_soft; color: @accent_text; }
QMessageBox QLabel { color: @text; }
QMessageBox QPushButton { min-width: 68px; }

/* ---------- login ---------- */
QFrame#loginStory {
    background: transparent; border: none; border-radius: 0;
    border-left: 2px solid @accent;
}
QFrame#loginStory QWidget { background: transparent; }
QLabel#loginStoryTitle {
    font-family: "Songti SC", "SimSun", serif;
    font-size: 40px; font-weight: 700; color: @title; letter-spacing: 3px; line-height: 1.4;
}
QLabel#loginStoryCopy { color: @muted; font-size: 13px; }
QLabel#loginStoryFoot { color: @muted; font-size: 11px; letter-spacing: 2px; }
QFrame#loginCard { background: transparent; border: none; }
QLabel#titleLabel {
    font-family: "Songti SC", "SimSun", serif;
    color: @title; font-size: 30px; font-weight: 700; letter-spacing: 3px;
}
QLabel#loginBrand { font-size: 12px; font-weight: 600; letter-spacing: 4px; }

/* ---------- break reminder ---------- */
QWidget#breakReminderWindow { background: transparent; }
QFrame#breakReminderCard { background: transparent; border: none; border-radius: 0; }
QLabel#reminderStatusDot { color: @accent; font-size: 8px; }
QLabel#reminderEyebrow { color: @muted; font-size: 11px; font-weight: 500; letter-spacing: 2.4px; }
QLabel#reminderModeChip {
    border: 1px solid @accent_border; color: @accent_text;
    border-radius: 2px; padding: 3px 8px; font-size: 11px; letter-spacing: 1px;
}
QFrame#reminderTimeBlock { background: transparent; border: 1px solid @rule; border-radius: 2px; }
QLabel#reminderMinutes {
    font-family: "Songti SC", "SimSun", serif;
    color: @title; font-size: 34px; font-weight: 700;
}
QLabel#reminderUnit { color: @muted; font-size: 11px; letter-spacing: 2px; }
QLabel#reminderTitle {
    font-family: "Songti SC", "SimSun", serif;
    color: @title; font-size: 22px; font-weight: 700; letter-spacing: 2px;
}
QLabel#reminderMessage { color: @text; font-size: 12px; }
QLabel#reminderMeta { color: @muted; font-size: 11px; letter-spacing: 1px; }
QFrame#reminderRule { background: @rule; border: none; }
QPushButton#reminderAcknowledgeButton {
    background: @ink_fill; color: @on_ink; border: 1px solid @ink_fill;
    border-radius: 2px; font-weight: 600; padding: 0; letter-spacing: 2px;
    min-height: 32px; max-height: 32px; min-width: 90px; max-width: 90px;
}
QPushButton#reminderAcknowledgeButton:hover { background: @accent; border-color: @accent; }

/* ---------- appearance ---------- */
QPushButton.themeChoice {
    text-align: left; background: transparent; color: @text;
    border: 1px solid @border; border-radius: 2px; padding: 11px 14px; min-height: 30px;
    letter-spacing: 1px;
}
QPushButton.themeChoice:hover { border-color: @border_strong; background: @hover; }
QPushButton.themeChoice:checked { border: 1px solid @accent; color: @accent_text; font-weight: 600; }
QPushButton.themeChoice:focus { border-color: @focus; }
QLabel#themeSaveStatus { color: @muted; font-size: 12px; padding: 6px 0; letter-spacing: 1px; }
QLabel#themeSource { color: @muted; font-size: 12px; }
QPushButton.appearanceMode {
    background: transparent; color: @text; border: 1px solid @border;
    border-radius: 2px; text-align: left; padding: 12px 16px; min-height: 20px; letter-spacing: 1px;
}
QPushButton.appearanceMode:hover { background: @hover; border-color: @border_strong; }
QPushButton.appearanceMode:checked { border-color: @accent; color: @accent_text; font-weight: 600; background: @accent_soft; }
QLabel#appearanceSectionTitle { color: @muted; font-size: 11px; font-weight: 600; letter-spacing: 1.6px; }

/* ---------- dial buttons ---------- */
QPushButton#dialPrimary {
    background: @ink_fill; border: 1px solid @ink_fill;
    border-radius: 36px; padding: 0;
    min-width: 70px; max-width: 70px; min-height: 70px; max-height: 70px;
}
QPushButton#dialPrimary:hover { border: 1px solid @accent; }
QPushButton#dialPrimary:pressed { background: @accent; border-color: @accent; }
QPushButton#dialPrimary:disabled { background: transparent; border-color: @border; }
QPushButton#dialGhost {
    background: transparent; border: 1px solid @border_strong;
    border-radius: 26px; padding: 0;
    min-width: 50px; max-width: 50px; min-height: 50px; max-height: 50px;
}
QPushButton#dialGhost:hover { background: @hover; border-color: @muted; }
QPushButton#dialGhost:pressed { background: @pressed; }
QPushButton#dialGhost:disabled { border-color: @border; }

/* ---------- view switch ---------- */
QPushButton#viewSwitch {
    border: none; border-bottom: 1.5px solid transparent;
    padding: 5px 2px; margin-right: 18px;
    color: @muted; font-size: 13px; letter-spacing: 2px; border-radius: 0;
}
QPushButton#viewSwitch:hover { color: @text; background: transparent; }
QPushButton#viewSwitch:checked { color: @text; border-bottom: 1.5px solid @accent; font-weight: 600; }
